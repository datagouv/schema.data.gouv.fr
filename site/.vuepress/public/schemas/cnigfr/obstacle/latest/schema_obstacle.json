{
  "$schema": "https://specs.frictionlessdata.io/schemas/table-schema.json",
  "name": "obstacle",
  "title": "Classe OBSTACLE du standard CNIG Accessibilité du Cheminement en Espace Naturel (ACEN)",
  "description": "Spécification du fichier d'échange conforme au standard CNIG Accessibilité du Cheminement en Espace Naturel pour la classe OBSTACLE",
  "keywords": [
    "accessibilité",
    "cheminement",
    "parcours",
    "itinéraire",
    "randonnée",
    "espace naturel",
    "nature"
  ],
  "countryCode": "FR",
  "homepage": "https://github.com/cnigfr/standard-accessibilite-espace-naturel",
  "path": "https://github.com/cnigfr/standard-accessibilite-espace-naturel/raw/v0.1.0/schema/obstacle/schema_obstacle.json",
  "image": "",
  "licenses": [
    {
      "title": "Etalab Licence Ouverte 2.0",
      "name": "etalab-2.0",
      "path": "https://spdx.org/licenses/etalab-2.0.html"
    }
  ],
  "resources": [
    {
      "title": "Exemple valide",
      "name": "exemple-valide-csv",
      "path": "https://github.com/cnigfr/standard-accessibilite-espace-naturel/raw/v0.1.0/schema/obstacle/exemple_obstacle.csv"
    }
  ],
  "sources": [
    {
      "title": "Directive européenne Inspire -  article L. 127-1 du code de l’environnement, résultant de la transposition de la directive",
      "path": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000022964012"
    },
    {
      "title": "Loi du 11 février 2005 pour l’égalité des droits et des chances, la participation et la citoyenneté des personnes handicapées",
      "path": "https://handicap.gouv.fr/la-loi-du-11-fevrier-2005-pour-legalite-des-droits-et-des-chances"
    },
    {
      "title": "Loi n° 2019-1428 du 24 décembre 2019 d’orientation des mobilités (LOM)",
      "path": "https://www.legifrance.gouv.fr/jorf/id/JORFTEXT000039666574"
    },
    {
      "title": "Article 4( de la loi n° 2005-102 du 11 février 2005 pour l'égalité des droits et des chances, la participation et la citoyenneté des personnes handicapées.",
      "path": "https://www.legifrance.gouv.fr/jorf/article_jo/JORFARTI000002461485"
    }
  ],
  "created": "2026-04-20",
  "lastModified": "2026-09-29",
  "version": "v0.1.0",
  "contributors": [
    {
      "title": "GT CNIG Accessibilité du cheminement en espace naturel (ACEN)",
      "email": "cnig@cnig.fr",
      "organisation": "CNIG",
      "role": "author"
    },
    {
      "title": "Arnauld Gallais",
      "email": "arnauld.gallais@cerema.fr",
      "organisation": "Cerema",
      "role": "author"
    }
  ],
  "fields": [
    {
      "name": "id_obstacle",
      "title": "identifiant de l'obstacle",
      "description": "identifiant unique de l'obstacle",
      "example": "44003:OBS:00112:LOC",
      "type": "string",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "id_troncon",
      "title": "identifiant du troncon",
      "description": "identifiant du tronçon sur lequel est rencontré l'obstacle",
      "example": "44003:TRC:00089:LOC",
      "type": "string",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "id_osm",
      "title": "identifiant OSM de l’objet correspondant",
      "description": "identifiant osm de l’objet correspondant",
      "example": "",
      "type": "integer"
    },
    {
      "name": "type_obstacle",
      "title": "type d'obstacle",
      "description": "type d'obstacle",
      "example": [
            "ressaut",
            "nid de poule"
         ],
      "type": "array",
      "arrayItem": {
            "type": "string",
            "constraints": {
               "required": true,
               "enum": [
                "fente et cunette",
                "nid de poule",
                "rocher, pierre saillante",
                "motte de terre ou d'herbe",
                "herbe haute",
                "racine saillante",
                "bloc de pierre",
                "caillou",
                "débris ou gravats",
                "fossé, ravine ou affaissement","ressaut",
                "ornière, trou, creux",
                "obstacle en saillie",
                "branche ou tronc d’arbre",
                "névé éternel",
                "marche isolée",
                "escalier avec main courante",
                "escalier sans main courante",
                "croisement avec autres usagers",
                "traversée sécurisée de piste cyclable",
                "traversée non sécurisée de piste cyclable",
                "traversée sécurisée de route automobile",
                "traversée non sécurisée de route automobile",
                "portion de sentier qui longe une route",
                "passage canadien",
                "barrière tournante PMR/UFR",
                "barrière non PMR/UFR",
                "barrière non détectable",
                "espace confiné",
                "rupture de niveau",
                "plan d'eau non sécurisé",
                "passage aérien",
                "potelet, poteau",
                "cordage, chaîne ou chaîne tendue",
                "‍clôture ou grillage",
                "haie",
                "portail ou portillon",
                "autre",
                "NC",
                "sans objet"
              ]
            }
          }
    },
    {
      "name": "description_obstacle",
      "title": "description de l’obstacle",
      "description": "description de l’obstacle",
      "example": "le ressaut en ciment mesure 7 cm",
      "type": "string"
    },
    {
      "name": "url_media",
      "title": "hyperliens vers des photos de l’obstacle",
      "description": "hyperliens vers des photos représentatives de l’obstacle",
      "example": ["https://panoramax.fr/?&focus=pic&map=17/46.347392/2.593132&xyz=226.00/0.00/30"],
      "type": "array",
      "items": {
        "type":"string",
        "constraints":{
            "required":false,
            "pattern":"^(https?)://[^\\s/$.?#].[^\\s]*$"}
        }
    },
    {
      "name": "frequence_obstacle",
      "title": "fréquence d’obstacle gênant",
      "description": "fréquence d’obstacle",
      "example": "fréquents",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "aucun",
          "espacés",
          "réguliers",
          "fréquents",
          "très fréquents",
          "NC",
          "Sans objet"
        ]
      }
    },
    {
      "name": "reperabilite_obstacle",
      "title": "repérabilité de l’obstacle",
      "description": "obstacle repérable grâce à une signalétique claire",
      "example": "non",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "oui",
          "non"
        ]
      }
    },
    {
      "name": "coord_gps_obstacle",
      "title": "coordonnées géographiques de l'obstacle",
      "description": "coordonnées géographiques de l'obstacle",
      "example": "49.2527, 3.9815",
      "type": "geopoint"
    },
    {
      "name": "geom_pct",
      "title": "géométrie ponctuelle de l'obstacle",
      "description": "géométrie ponctuelle de l'obstacle en projection Lambert93 au format GeoJSON",
      "example":{
            "type":"Point",
            "coordinates":[
               656589.70,
               6425785.32
            ]
         },
         "type":"geojson",
         "constraints":{
            "required":true
      }
    }
  ],
  "missingValues": [
    "",
    "NA",
    "NaN",
    "N/A"
  ],
  "primaryKey": "id_obstacle"
}
