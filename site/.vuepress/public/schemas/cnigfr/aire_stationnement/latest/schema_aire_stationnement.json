      "title": "Arnauld Gallais",
      "email": "arnauld.gallais@cerema.fr",
      "organisation": "Cerema",
      "role": "author"
    }
  ],
  "fields": [
    {
      "name": "id_aire_stationnement",
      "title": "identifiant  de l'aire de stationnement",
      "description": "identifiant unique de l'aire de stationnement PMR",
      "example": "44003:AST:0007:LOC",
      "type": "string",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "id_cheminement",
      "title": "identifiant du cheminement",
      "description": "identifiant du cheminement desservi par l'aire de stationnement",
      "example": "44003:CHE:00654:LOC",
      "type": "string",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "nom_aire",
      "title": "nom de l'aire de stationnement",
      "description": "nom de l'aire de stationnement",
      "example": "Parking des Glaisins",
      "type": "string",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "adresse_aire",
      "title": "adresse de l'aire de stationnement",
      "description": "adresse de l'aire de stationnement",
      "example": "12 rue de la forêt",
      "type": "string"
    },
    {
      "name": "localisation_stationnement",
      "title": "localisation du stationnement",
      "description": "localisation du stationnement",
      "example": "parking",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "parking",
          "bord de route",
          "voirie",
          "chemin",
          "autre",
          "NC",
          "sans objet"
        ]
      }
    },
    {
      "name": "type_sol",
      "title": "type de sol majoritaire",
      "description": "type de sol majoritaire du tronçon",
      "example": "enrobé",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "béton",
          "enrobé / bitume",
          "stabilisé",
          "pavage",
          "dallage",
          "platelage",
          "sol naturel friable et poussiéreux",
          "sol naturel compact",
          "sol naturel irrégulier",
          "pelouse entretenue",
          "pelouse non entretenue",
          "prairie",
          "gravier maintenu",
          "gravier fin et compact",
          "gravier libre",
          "gros gravier",
          "sable stabilisé",
          "sable meuble",
          "sable non meuble (ferme)",
          "dispositifs amovibles",
          "autre",
          "NC",
          "sans objet"
        ]
      }
    },
    {
      "name": "etat_sol",
      "title": "état du sol",
      "description": "état du sol",
      "example": "roulant",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "roulant",
          "ferme",
          "meuble",
          "glissant",
          "réfléchissant",
          "boueux",
          "NC",
          "sans objet"
        ]
      }
    },
    {
      "name": "nb_place_pmr",
      "title": "nombre de stationnements PMR",
      "description": "nombre de stationnements PMR",
      "example": "3",
      "type": "integer",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "nb_place_allongee",
      "title": "nombre de stationnements allongés",
      "description": "nombre de stationnements allongés",
      "example": "0",
      "type": "integer"
    },
    {
      "name": "signaletique_pmr",
      "title": "présence de signalisation les stationnements PMR",
      "description": "présence (oui/non) de signalisation indiquant la spécificité du stationnement",
      "example": "oui",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "oui",
          "non"
        ]
      }
    },
    {
      "name": "marquage_sol",
      "title": "présence de marquage au sol",
      "description": "présence (oui/non) du marquage au sol : pictogramme et contour de la place",
      "example": "oui",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "oui",
          "non"
        ]
      }
    },
    {
      "name": "pente",
      "title": "pente de l’aire de stationnement",
      "description": "inclinaison du terrain dans le sens longitudinal du stationnement",
      "example": "minimale",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "nulle",
          "minimale",
          "faible",
          "moyenne",
          "forte"
        ]
      }
    },
    {
      "name": "devers",
      "title": "dévers de l’aire de stationnement",
      "description": "inclinaison du terrain dans le sens latéral du stationnement",
      "example": "minimale",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "minimale",
          "faible",
          "moyen",
          "fort",
          "NC",
          "sans objet"
        ]
      }
    },
    {
      "name": "mobilier",
      "title": "présence de mobilier",
      "description": "présence (oui/non) de mobilier",
      "example": "oui",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "oui",
          "non"
        ]
      }
    },
    {
      "name": "accrochage_deux_roues",
      "title": "présence de garage à deux-roues",
      "description": "présence (oui/non) d’un dispositif permettant le garage des deux-roues (bicyclette, mobylette, scooter, moto)",
      "example": "oui",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "oui",
          "non"
        ]
      }
    },
    {
      "name": "portique_limiteur",
      "title": "présence d’un portique limiteur",
      "description": "présence (oui/non) d’un portique limiteur",
      "example": "non",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "oui",
          "non"
        ]
      }
    },
    {
      "name": "url_media",
      "title": "hyperliens vers des photos de l'aire de stationnement",
      "description": "hyperliens vers des photos représentatives de l'aire de stationnement",
      "example": ["https://panoramax.fr/?&focus=pic&map=17/46.347392/2.593132&xyz=226.00/0.00/30"],
      "type": "array",
      "items": {
        "type":"string",
        "constraints":{
            "required":false,
            "pattern":"^(https?)://[^\\s/$.?#].[^\\s]*$"}
        }
    },
    {
      "name": "coord_gps_aire",
      "title": "coordonnées géographiques de l'aire de stationnement",
      "description": "coordonnées géographiques de l'aire de stationnement",
      "example": "49.2527, 3.9815",
      "type": "geopoint"
    },
    {
       "name": "geom_surf",
      "title": "géométrie ponctuelle ou surfacique de l'aire de stationnement",
      "description": "géométrie ponctuelle ou surfacique de l'aire de stationnement en projection Lambert93 au format GeoJSON",
      "example":{
            "type":"Polygon",
            "coordinates":[
               [
                  [
                     656589.70,
                     6425785.32
                  ],
                  [
                     656655.02,
                     6425866.31
                  ],
                  [
                     656663.55,
                     6425874.43
                  ],
                  [
                     656589.707,
                     6425785.32
                  ]
               ]
            ]
         },
         "type":"geojson",
         "constraints":{
            "required":true
      }
    }
  ],
  "missingValues": [
    "",
    "NA",
    "NaN",
    "N/A"
  ],
  "primaryKey": "id_aire_stationnement"
}
